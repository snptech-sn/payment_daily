rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data, userId) {
      return data.uid == userId &&
        data.email is string &&
        data.email.size() <= 256;
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
        data.id is string &&
        data.id.size() <= 128 &&
        (data.type == 'income' || data.type == 'expense') &&
        data.amount is number &&
        data.amount >= 0 &&
        (data.currency == 'USD' || data.currency == 'KHR') &&
        (('categoryId' in data && data.categoryId is string && data.categoryId.size() <= 64) || ('category' in data && data.category is string && data.category.size() <= 64)) &&
        data.date is string &&
        data.date.size() <= 32 &&
        data.paymentMethod is string &&
        data.paymentMethod.size() <= 64 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        (!('time' in data) || (data.time is string && data.time.size() <= 16)) &&
        (!('createdAt' in data) || (data.createdAt is number || data.createdAt is string)) &&
        (!('updatedAt' in data) || (data.updatedAt is number || data.updatedAt is string));
    }

    function isValidSettings(data, userId) {
      return data.userId == userId &&
        (data.primaryCurrency == 'USD' || data.primaryCurrency == 'KHR' || data.primaryCurrency == 'BOTH') &&
        data.exchangeRate is number &&
        data.exchangeRate > 0 &&
        (data.language == 'km' || data.language == 'en') &&
        (data.theme == 'emerald' || data.theme == 'indigo' || data.theme == 'warm' || data.theme == 'dark') &&
        (!('monthlyBudget' in data) || data.monthlyBudget is number) &&
        (!('updatedAt' in data) || (data.updatedAt is number || data.updatedAt is string));
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId);
      allow delete: if false;

      // Personal user transactions subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Personal user settings subcollection
      match /settings/{settingsId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingsId) && isValidSettings(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(settingsId);
      }
    }
  }
}
